{
    "name": "bjornbasar/karhu-queue",
    "description": "Minimal queue/worker abstraction for the karhu PHP microframework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "bjornbasar/karhu-db": "^0.1",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "bjornbasar/karhu-db": "For the database-backed queue driver"
    },
    "autoload": {
        "psr-4": {
            "Karhu\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karhu\\Queue\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
